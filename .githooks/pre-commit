#!/usr/bin/env bash
set -euo pipefail

# 앱 디렉터리별로 스테이징된 ts/tsx/js/jsx 파일을 해당 앱의 ESLint 로 검사한다
APPS="advertiser console e2e"

status=0
for app in $APPS; do
  staged_files=$(git diff --cached --name-only --diff-filter=ACM -- "$app/" | grep -E '\.(ts|tsx|js|jsx|mjs)$' || true)
  [ -z "$staged_files" ] && continue

  if ! grep -q '"lint"' "$app/package.json" 2>/dev/null; then
    echo "[pre-commit] $app: No lint script. Skipping."
    continue
  fi

  echo "[pre-commit] $app: Running ESLint on staged files..."
  # --fix 후 git add 하면 부분 스테이징(git add -p)한 변경까지 커밋되므로 검사만 수행
  if ! echo "$staged_files" | sed "s#^$app/##" | (cd "$app" && xargs -d '\n' npx --no-install eslint); then
    echo "[pre-commit] $app: ESLint failed. 'cd $app && npx eslint --fix <file>' 로 수정 후 다시 커밋하세요."
    status=1
  fi
done

[ $status -eq 0 ] && echo "[pre-commit] Done."
exit $status
